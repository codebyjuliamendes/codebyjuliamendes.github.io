{
  "name": "codebyjuliamendes-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Portfólio de Júlia Mendes — gerador estático sem dependências de runtime.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && node scripts/serve.mjs",
    "test": "node scripts/build.mjs && node --test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "prettier": "^3.3.3"
  }
}
